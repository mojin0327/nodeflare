{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodeflare.tech/schemas/verification-receipt.schema.json",
  "title": "NodeFlare Builder CI verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "workflow",
    "run_id",
    "run_attempt",
    "run_url",
    "event",
    "pr_number",
    "head_sha",
    "base_sha",
    "ref",
    "command",
    "scope",
    "status",
    "boundaries",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "repository": { "type": "string", "minLength": 1 },
    "workflow": { "type": "string", "minLength": 1 },
    "run_id": { "type": "integer", "minimum": 1 },
    "run_attempt": { "type": "integer", "minimum": 1 },
    "run_url": { "type": "string", "format": "uri" },
    "event": { "type": "string", "minLength": 1 },
    "pr_number": { "type": ["integer", "null"], "minimum": 1 },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "base_sha": { "type": "string", "pattern": "^$|^[0-9a-f]{40}$" },
    "ref": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "status": { "enum": ["success", "failure", "cancelled", "skipped", "not_run"] },
    "boundaries": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
