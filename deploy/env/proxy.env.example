# NodeFlare Proxy — environment variables
# Copy to /opt/nodeflare/env/proxy.env and fill in values

# --- Database & Redis ---
DATABASE_URL=postgres://user:password@localhost/nodeflare
REDIS_URL=redis://localhost:6379

# --- Auth (same as API) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Proxy listen ---
PORT=8080

# --- Code runner shared secret ---
CODE_RUNNER_TOKEN=change-me-same-as-code-runner-service

# --- VM fork lifecycle (Unix socket mode) ---
# When set, proxy uses Unix socket to manage fork VM lifecycle instead of HTTP kill-fork.
# OS-guaranteed cleanup: fork VMs are killed even if the proxy process crashes.
# Must match FORK_SOCKET_PATH in builder.env.
FORK_SOCKET_PATH=/var/run/nodeflare/fork.sock


# --- Logging ---
RUST_LOG=info
