# NodeFlare Builder — environment variables
# Copy to /opt/nodeflare/env/builder.env and fill in values

# --- Database & Queue ---
DATABASE_URL=postgres://user:password@localhost/nodeflare
REDIS_URL=redis://localhost:6379

# --- Container Registry ---
# e.g. ghcr.io/YOUR_GITHUB_ORG
CONTAINER_REGISTRY_BASE=ghcr.io/your-org
# GitHub PAT with write:packages scope
CONTAINER_REGISTRY_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- Container socket / data directories ---
# Path where nerdctl socket lives (default /var/run/containerd/containerd.sock)
# CONTAINER_SOCKET_DIR=/var/run/containerd
# Persistent data volume mounted into MCP containers
# CONTAINER_DATA_DIR=/var/lib/mcp-data

# --- Builder HTTP API ---
# Port for the internal HTTP API (exec / stats / metrics)
BUILDER_HTTP_PORT=8083
# Shared secret for API → Builder calls (set the same value in API's env)
BUILDER_TOKEN=change-me-to-a-random-secret

# --- GitHub (for private repo clones) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# --- Logging ---
RUST_LOG=info
